# Copy ordinary startup settings to .env, or enter keys in the Settings page.
# A non-empty legacy key in .env is migrated into the OS-protected encrypted
# vault on verified startup and then blanked here; plaintext is not retained.
DEEPSEEK_API_KEY=
DEEPSEEK_BACKUP_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional universal AI Code Mirror relay key for its Claude, OpenAI, and Gemini channels.
ELREN_AICODEMIRROR_API_KEY=
ELREN_AICODEMIRROR_FABLE_API_KEY=
# Optional Pollinations key for free-catalog image generation.
ELREN_POLLINATIONS_API_KEY=
# Optional free-account Read token. Authenticated free accounts receive a
# larger included daily ZeroGPU quota than anonymous requests.
ELREN_HUGGINGFACE_TOKEN=
# OCR priority: Windows local OCR, then local PaddleOCR AI. The configured
# Google vision endpoint is used only when visual semantics are required.
# Final semantic-vision fallback only. Gemini's free developer tier has quotas.
ELREN_VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ELREN_VISION_API_KEY=
ELREN_VISION_MODEL=gemini-3.6-flash
# Set true only when you also want to probe local LM Studio, Ollama, or vLLM services.
ELREN_VISION_AUTO_DISCOVER=false
# Optional trusted local command, launched only when a task first needs vision.
ELREN_VISION_START_COMMAND=
ELREN_VISION_START_TIMEOUT=45

# Optional OpenClaw compatibility runtime / Gateway bridge.
ELREN_OPENCLAW_ENABLED=true
ELREN_OPENCLAW_CLI=
ELREN_OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
ELREN_OPENCLAW_GATEWAY_TOKEN=
ELREN_OPENCLAW_AUTO_START=true
# Optional Feishu bot channel. The official long connection only needs App ID/Secret.
ELREN_FEISHU_ENABLED=true
ELREN_FEISHU_BASE_URL=https://open.feishu.cn
ELREN_FEISHU_APP_ID=
ELREN_FEISHU_APP_SECRET=
ELREN_FEISHU_OPEN_ID=
# Optional Telegram bot channel. Chat ID can be learned from the first message.
ELREN_TELEGRAM_BOT_TOKEN=
ELREN_TELEGRAM_CHAT_ID=
ELREN_HOST=127.0.0.1
ELREN_PORT=8765
ELREN_MOBILE_PORT=8768
ELREN_WORKSPACE=.
# 0 uses the selected provider's highest output limit.
ELREN_MAX_OUTPUT_TOKENS=0
ELREN_REQUEST_TIMEOUT=180
