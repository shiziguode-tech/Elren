{
  "schema": 1,
  "bundle": "elren-tool-runtime",
  "product_version": "1.0",
  "platform": "windows-x86_64",
  "policy": {
    "docker_required": false,
    "duplicate_python_or_node": false,
    "default_max_extracted_bytes": 681574400,
    "download_sources": "upstream-project-or-upstream-endorsed-only",
    "credentials_in_bundle": false
  },
  "profiles": {
    "default": [
      "jq",
      "ripgrep",
      "github-cli",
      "ffmpeg-lgpl",
      "xurl-binary",
      "audiveris",
      "node-cli-default"
    ],
    "extended": [
      "jq",
      "ripgrep",
      "github-cli",
      "ffmpeg-lgpl",
      "xurl-binary",
      "pandoc",
      "mingit",
      "audiveris",
      "node-cli-extended"
    ]
  },
  "artifacts": [
    {
      "id": "jq",
      "version": "1.8.2",
      "publisher": "jqlang/jq",
      "source": "https://github.com/jqlang/jq",
      "url": "https://github.com/jqlang/jq/releases/download/jq-1.8.2/jq-windows-amd64.exe",
      "sha256": "a6fc67fedaf9128a3309a1e2ebb8b986aeccf70122ee46d2cb4849e423f0c627",
      "archive": "file",
      "install": [
        {"source": "jq-windows-amd64.exe", "destination": "native/jq/jq.exe"}
      ],
      "license": "MIT",
      "license_url": "https://raw.githubusercontent.com/jqlang/jq/jq-1.8.2/COPYING",
      "license_sha256": "ad2b4a266b2268939c1446979759706077421cf906a203aa188c6f396e8cfd74"
    },
    {
      "id": "ripgrep",
      "version": "15.2.0",
      "publisher": "BurntSushi/ripgrep",
      "source": "https://github.com/BurntSushi/ripgrep",
      "url": "https://github.com/BurntSushi/ripgrep/releases/download/15.2.0/ripgrep-15.2.0-x86_64-pc-windows-msvc.zip",
      "sha256": "71b2fef860abe467217a538ff31de02f5258807c0129f771846f87bd029aafc5",
      "archive": "zip",
      "install": [
        {"source": "*/rg.exe", "destination": "native/ripgrep/rg.exe"},
        {"source": "*/COPYING", "destination": "licenses/ripgrep-COPYING"},
        {"source": "*/LICENSE-MIT", "destination": "licenses/ripgrep-LICENSE-MIT"}
      ],
      "license": "Unlicense OR MIT"
    },
    {
      "id": "github-cli",
      "version": "2.97.0",
      "publisher": "cli/cli",
      "source": "https://github.com/cli/cli",
      "url": "https://github.com/cli/cli/releases/download/v2.97.0/gh_2.97.0_windows_amd64.zip",
      "sha256": "35d7fe05c4dd1411ffda1e73dfc7c6f44b75c936ca51fa6595c657fdc0350cec",
      "archive": "zip",
      "install": [
        {"source": "*bin/gh.exe", "destination": "native/github-cli/gh.exe"},
        {"source": "*LICENSE", "destination": "licenses/github-cli-LICENSE"}
      ],
      "license": "MIT"
    },
    {
      "id": "ffmpeg-lgpl",
      "version": "8.1.2-34-g9b6c8969e0+btbn-20260812",
      "publisher": "BtbN/FFmpeg-Builds",
      "source": "https://github.com/BtbN/FFmpeg-Builds",
      "upstream_endorsement": "https://ffmpeg.org/download.html#build-windows",
      "url": "https://github.com/BtbN/FFmpeg-Builds/releases/download/autobuild-2026-08-12-13-15/ffmpeg-n8.1.2-34-g9b6c8969e0-win64-lgpl-shared-8.1.zip",
      "sha256": "375df631ddf38bf38feb7bbd67259c454045b8ea75b96af62c33a440ba799f48",
      "archive": "zip",
      "install": [
        {"source": "*/bin/*.exe", "destination": "native/ffmpeg/bin", "include_names": ["ffmpeg.exe", "ffprobe.exe"]},
        {"source": "*/bin/*.dll", "destination": "native/ffmpeg/bin"},
        {"source": "*/LICENSE.txt", "destination": "licenses/ffmpeg-LICENSE.txt"}
      ],
      "license": "LGPL-2.1-or-later",
      "notes": "Pinned by SHA-256. FFmpeg's official download page endorses BtbN Windows builds. Shared LGPL build avoids duplicating libraries between ffmpeg and ffprobe."
    },
    {
      "id": "pandoc",
      "version": "3.10.2",
      "publisher": "jgm/pandoc",
      "source": "https://github.com/jgm/pandoc",
