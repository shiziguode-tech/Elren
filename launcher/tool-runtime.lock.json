      "sha256": "52487faaa63f8cef5363d5a771097da001228d61c6f44f32ed41b27a98c0278c",
      "archive": "zip",
      "install": [
        {"source": "*/pandoc.exe", "destination": "native/pandoc/pandoc.exe"},
        {"source": "*/COPYING.md", "destination": "licenses/pandoc-COPYING.md"}
      ],
      "license": "GPL-2.0-or-later"
    },
    {
      "id": "xurl-binary",
      "version": "1.3.1",
      "publisher": "xdevplatform/xurl",
      "source": "https://github.com/xdevplatform/xurl",
      "url": "https://github.com/xdevplatform/xurl/releases/download/v1.3.1/xurl_Windows_x86_64.zip",
      "sha256": "6b5e7435daa98d03a620b2a31b8c78162601959a63274e945ae372c799073305",
      "archive": "zip",
      "install": [
        {"source": "xurl.exe", "destination": "native/xurl/xurl.exe"},
        {"source": "LICENSE", "destination": "licenses/xurl-LICENSE"}
      ],
      "license": "MIT"
    },
    {
      "id": "mingit",
      "version": "2.55.0.4",
      "publisher": "git-for-windows/git",
      "source": "https://github.com/git-for-windows/git",
      "url": "https://github.com/git-for-windows/git/releases/download/v2.55.0.windows.4/MinGit-2.55.0.4-64-bit.zip",
      "sha256": "4e03f94c2ffbf70be337e005cee02661c732dbfc81031a078bda9299b9a7d644",
      "archive": "zip-tree",
      "destination": "native/mingit",
      "license": "GPL-2.0-only"
    }
  ],
